{
  "name": "chintai-kouho-test",
  "private": true,
  "type": "module",
  "description": "firestore.rules のテスト。アプリ本体はビルド不要で、この中だけが Node を使います",
  "scripts": {
    "test": "npm run test:worker && npm run test:rules",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-chintai \"node firestore.rules.test.mjs\"",
    "test:worker": "node worker.fetch.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0"
  }
}
