rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 部屋ドキュメント自体は誰にも読ませない。
    // ここを開けると /lists を一覧クエリして部屋IDを総当たりで集められてしまうため、
    // 実データはすべて配下のサブコレクションに置いている。
    //
    // 配下の許可に match /{document=**} を使ってはいけない。
    // 再帰ワイルドカードは「0個以上」のセグメントに一致するため親ドキュメント自身にも掛かり、
    // ここの deny を打ち消してしまう（実際にルールテストで確認済み）。
    // そのため、扱うパスをすべて明示的に列挙している。
    match /lists/{roomId} {
      allow read, write: if false;

      // 共有ID（roomId）を知っている人だけがこのパスに到達できる。
      // 匿名認証を必須にして、未認証のクライアントからのアクセスを弾く。
      match /members/{uid} {
        allow read, write: if request.auth != null;
      }

      match /properties/{propertyId} {
        allow read, write: if request.auth != null;

        match /comments/{commentId} {
          allow read, write: if request.auth != null;
        }
      }
    }
  }
}
